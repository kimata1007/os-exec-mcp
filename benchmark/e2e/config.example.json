{
  "confirmPublicRepositoryCreation": false,
  "owner": "REPLACE_WITH_GITHUB_OWNER",
  "repositoryPrefix": "os-batch-e2e",
  "workspaceRoot": "/private/tmp/os-batch-e2e-workspaces",
  "resultsDirectory": "../results/e2e",
  "promptFile": "task.md",
  "pollIntervalMs": 5000,
  "agentTimeoutMs": 1800000,
  "deploymentTimeoutMs": 600000,
  "modes": {
    "baseline": {
      "label": "Claude Code baseline",
      "command": "claude",
      "args": [
        "--print",
        "--verbose",
        "--output-format",
        "stream-json",
        "--permission-mode",
        "auto",
        "--no-session-persistence",
        "--strict-mcp-config",
        "--model",
        "REPLACE_WITH_EXPLICIT_MODEL"
      ],
      "model": "REPLACE_WITH_EXPLICIT_MODEL",
      "mcpEnabled": false,
      "environment": {}
    },
    "mcp": {
      "label": "Claude Code with os-batch-mcp",
      "command": "claude",
      "args": [
        "--print",
        "--verbose",
        "--output-format",
        "stream-json",
        "--permission-mode",
        "auto",
        "--no-session-persistence",
        "--strict-mcp-config",
        "--mcp-config",
        "{{MCP_CONFIG}}",
        "--model",
        "REPLACE_WITH_EXPLICIT_MODEL"
      ],
      "model": "REPLACE_WITH_EXPLICIT_MODEL",
      "mcpEnabled": true,
      "environment": {}
    }
  }
}
