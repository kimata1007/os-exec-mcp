{
  "name": "os-exec-mcp",
  "version": "0.2.0",
  "description": "Secure MCP server for command DAGs and sandboxed programmatic orchestration",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "claude",
    "parallel",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimata1007/os-exec-mcp.git"
  },
  "homepage": "https://github.com/kimata1007/os-exec-mcp#readme",
  "bugs": {
    "url": "https://github.com/kimata1007/os-exec-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "os-exec-mcp": "dist/mcp/stdio.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/make-executable.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "npm run build && vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run clean && npm run build",
    "start": "node dist/mcp/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "quickjs-emscripten": "0.32.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.34"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
