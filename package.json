{
  "name": "os-batch-mcp",
  "version": "0.1.0",
  "description": "Secure MCP server for parallel batched OS command execution",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "os-batch-mcp": "./dist/mcp/stdio.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/make-executable.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "npm run build && vitest",
    "benchmark": "npm run benchmark:component",
    "benchmark:component": "npm run build && node scripts/benchmark.mjs",
    "benchmark:e2e": "npm run build && node scripts/e2e-benchmark.mjs",
    "benchmark:e2e:report": "node scripts/e2e-report.mjs",
    "benchmark:e2e:profile": "node scripts/agent-profile.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "start": "node dist/mcp/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
