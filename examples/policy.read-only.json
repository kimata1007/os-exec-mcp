{
  "workspaceRoots": ["."],
  "maxBatchSize": 16,
  "maxConcurrency": 16,
  "defaultConcurrency": 8,
  "defaultTimeoutMs": 10000,
  "maxTimeoutMs": 60000,
  "defaultMaxOutputBytes": 65536,
  "absoluteMaxOutputBytes": 1048576,
  "allowedEnvironmentKeys": [],
  "inheritExecutablePath": false,
  "commandMode": "allowlist",
  "deniedCommands": [],
  "commands": {
    "git": {
      "allowed": true,
      "allowedSubcommands": ["status", "diff", "log", "show", "rev-parse", "ls-files"],
      "readOnly": true
    },
    "rg": {
      "allowed": true,
      "readOnly": true
    },
    "ls": {
      "allowed": true,
      "readOnly": true
    },
    "find": {
      "allowed": true,
      "readOnly": true
    },
    "cat": {
      "allowed": true,
      "readOnly": true
    },
    "head": {
      "allowed": true,
      "readOnly": true
    },
    "tail": {
      "allowed": true,
      "readOnly": true
    },
    "wc": {
      "allowed": true,
      "readOnly": true
    },
    "stat": {
      "allowed": true,
      "readOnly": true
    },
    "du": {
      "allowed": true,
      "readOnly": true
    },
    "pwd": {
      "allowed": true,
      "readOnly": true
    }
  },
  "logLevel": "info",
  "readOnly": true
}
